{
  "name": "modelchef",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "episode": "tsx --env-file-if-exists=.env src/episode.ts",
    "episode:mock": "MOCK=1 DATA_DIR=.mock-data tsx src/episode.ts",
    "build": "tsx src/build-site.ts",
    "build:mock": "DATA_DIR=.mock-data tsx src/build-site.ts",
    "check-models": "tsx --env-file-if-exists=.env src/check-models.ts",
    "typecheck": "tsc --noEmit",
    "list-models": "tsx --env-file-if-exists=.env src/list-models.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
